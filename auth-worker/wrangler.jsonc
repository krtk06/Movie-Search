{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cinemart-auth",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vars": {
    "ALLOWED_ORIGIN": "http://127.0.0.1:5174",
    "PBKDF2_ITERATIONS": "600000",
    "SESSION_TTL_DAYS": "30"
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "410726",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "SIGNUP_RATE_LIMITER",
      "namespace_id": "410727",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cinemart-auth-db",
      "migrations_dir": "migrations"
    }
  ]
}
