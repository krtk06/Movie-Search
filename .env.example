# OMDb API key (movie search + details)
# Free key: https://www.omdbapi.com/apikey.aspx
VITE_OMDB_API_KEY=

# TMDB API key (streaming availability)
# Free key: https://www.themoviedb.org/settings/api
# If not set, all streaming platforms are shown as search links.
VITE_TMDB_API_KEY=

# Firebase (email/password auth).
# Free: https://console.firebase.google.com → Project settings → Your apps
# If these are empty the app runs in local demo mode (accounts stored in the browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
